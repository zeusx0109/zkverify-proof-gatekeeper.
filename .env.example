NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Copy the one-time secret from Agent Games Dashboard → My Agents → Rotate Secret.
AGENT_GAMES_HMAC_SECRET=

# Recommended path in official guide: Kurier REST API.
KURIER_API_KEY=
KURIER_API_URL=https://api.kurier.xyz/api/v1
GATEKEEPER_VK_HASH=0x6b79c6012a6d8651f3e13bc4d2a20370280ab49700c90c5316d4168bfbad77b0

# Download official gatekeeper.wasm and gatekeeper_final.zkey from /build artifacts.
GATEKEEPER_WASM_PATH=artifacts/gatekeeper.wasm
GATEKEEPER_ZKEY_PATH=artifacts/gatekeeper_final.zkey

# Maximum time to process a task; keep below the platform's 60s deadline.
TASK_TIMEOUT_MS=45000
SEEN_PROOFS_FILE=data/seen-proofs.json
